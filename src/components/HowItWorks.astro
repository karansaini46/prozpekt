---
// HowItWorks.astro - 3-step redemption guide
---

<section class="steps-section" aria-labelledby="steps-heading">
  <div class="steps-container">
    <div class="section-intro">
      <span class="section-eyebrow">Simple & Instant</span>
      <h2 id="steps-heading" class="section-title">How it works</h2>
    </div>

    <ol class="steps-grid" role="list">
      <li class="step-card">
        <div class="step-badge" aria-hidden="true">01</div>
        <div class="step-body">
          <h3 class="step-title">Claim in 10 seconds</h3>
          <p class="step-description">
            Enter your name and phone number. No lengthy signups, passwords, or app downloads required.
          </p>
        </div>
      </li>

      <li class="step-card">
        <div class="step-badge" aria-hidden="true">02</div>
        <div class="step-body">
          <h3 class="step-title">Get your instant code</h3>
          <p class="step-description">
            A unique <code class="code-pill">MORROW-XXXX</code> discount voucher appears right on your screen. Tap to copy.
          </p>
        </div>
      </li>

      <li class="step-card">
        <div class="step-badge" aria-hidden="true">03</div>
        <div class="step-body">
          <h3 class="step-title">Show at the counter</h3>
          <p class="step-description">
            Visit us in Sector 104 and flash the code before billing. Enjoy ₹150 off your artisanal brew and treats.
          </p>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .steps-section {
    padding: var(--space-8) var(--space-4);
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .steps-container {
    max-width: 1120px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .section-intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .section-eyebrow {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .section-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    list-style: none;
  }

  .step-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4);
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .step-badge {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background-color: var(--color-primary-tint);
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    border: 1px solid rgba(158, 67, 11, 0.2);
    flex-shrink: 0;
  }

  .step-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .step-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
  }

  .step-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: var(--line-height-normal);
  }

  .code-pill {
    display: inline-block;
    background-color: var(--color-surface);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-primary);
    border: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .steps-section {
      padding: var(--space-10) var(--space-6);
    }

    .steps-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }

    .step-card {
      flex-direction: column;
      gap: var(--space-3);
      padding: var(--space-5);
    }
  }

  @media (min-width: 1024px) {
    .steps-section {
      padding: var(--space-12) var(--space-8);
    }

    .section-title {
      font-size: var(--font-size-3xl);
    }

    .step-card {
      padding: var(--space-6);
    }
  }
</style>
